# Copy this file to .env and fill in your keys. Never commit .env.
GROQ_API_KEY=
TAVILY_API_KEY=
API_BEARER_TOKEN=

# Optional semantic response cache for stateless API requests. Disabled by default.
# Responses are shared among cache-enabled API clients; enable only for a trusted,
# single-tenant deployment. Corpus ingestion clears the cache.
# API_SEMANTIC_CACHE_ENABLED=false
# API_SEMANTIC_CACHE_DB=data/semantic_cache.sqlite
# API_SEMANTIC_CACHE_THRESHOLD=0.96
# API_SEMANTIC_CACHE_MAX_ENTRIES=2000

# Optional: enable only if prompts and tool results may be sent to LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=nexus-agent
